# ---------------------------------------------------------------------------
# EMBER & SPICE — environment variables
# Copy to .env for local use, or set these in Vercel → Project → Settings →
# Environment Variables. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# Neon PostgreSQL connection string (pooled connection is fine).
# Looks like: postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL=

# Admin account — created by the seed script on first deploy.
# Use a STRONG password in production. Change these before the first seed.
ADMIN_EMAIL=admin@emberandspice.in
ADMIN_PASSWORD=

# Public production URL (drives SEO metadata, canonical URLs, sitemap).
# Set to your Vercel URL after the first deploy, e.g. https://ember-and-spice.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
